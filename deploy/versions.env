# Every component the cluster runs, pinned. Images by digest, downloads by checksum; scripts and workflows read
# this file and nothing else, so a bump is one line here and the cluster workflow proves it.

KIND_VERSION=v0.33.0
KIND_SHA256_LINUX_AMD64=aee6151561422756b764a4ae28e7f44cda5af5a9eead3cc9985112b1de8d8e0d
KIND_NODE_IMAGE=kindest/node:v1.37.0
KIND_CONTEXT=kind-irb

# Model servers: the llm-d vLLM simulator (no GPUs), with a vLLM render server that tokenizes prompts so the
# simulated prefix cache hashes real token blocks.
SIM_IMAGE=ghcr.io/llm-d/llm-d-inference-sim:v1.0.0@sha256:1908c421cbb44130a3212934a0dd1e279dacfe3480be93f4c28b45cd29b93ec8
RENDER_IMAGE=docker.io/vllm/vllm-openai-cpu:v0.21.0@sha256:fc78b363009faa519a0adb5f1a287a533a922970f4463e73c00053a4aa2136e8
MODEL=Qwen/Qwen2.5-1.5B-Instruct

# Router: the llm-d Router in standalone mode (Envoy + endpoint picker), installed from its Helm chart at the
# v1.0.0 commit, and the InferencePool CRD from the Gateway API Inference Extension it implements.
ROUTER_REPO=https://github.com/llm-d/llm-d-router
ROUTER_VERSION=v1.0.0
ROUTER_COMMIT=b9393d1a9f1d5a72ecd86f8d2b643ab54c2a9b92
EPP_IMAGE=ghcr.io/llm-d/llm-d-router-endpoint-picker:v1.0.0@sha256:024188e998f516879f68532016ca24fabca00afbdcc2af9a61b17634e197df2c
ENVOY_IMAGE=docker.io/envoyproxy/envoy:distroless-v1.33.2@sha256:85500e28ed088ec39ff0adc1be3d358a8ad062926aaa62c36b28bde00919e4e8
GIE_VERSION=v1.6.2
GIE_CRDS_SHA256=f410dfca474608c02903087b47f1ac081706dfb6dfe7f83d00a7cc7e00c4ad0d

# The load client's image is built from Dockerfile on this base.
PYTHON_IMAGE=docker.io/library/python:3.12.12-slim-bookworm@sha256:593bd06efe90efa80dc4eee3948be7c0fde4134606dd40d8dd8dbcade98e669c

HELM_VERSION=v4.3.1
